# Wikipedia API (no key required, free to use)
WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1

# AI Image Generation (Replicate API)
# Get your token at: https://replicate.com/account
REPLICATE_API_TOKEN=your_replicate_token_here

# Site URL (used for Open Graph meta tags and sitemap)
SITE_URL=https://today-in-history.pages.dev

# Deployment
CLOUDFLARE_PAGES_PROJECT=today-in-history