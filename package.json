{
  "name": "today-in-history",
  "version": "1.0.0",
  "description": "A personalized Today in History platform with AI-generated visuals and passion-based niche exploration.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "live-server src --port=3000 --no-browser",
    "build": "node build.js",
    "lint": "eslint src/js/**/*.js",
    "format": "prettier --write .",
    "prepare": "husky",
    "check-env": "node scripts/check-env.js",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "keywords": [
    "history",
    "today-in-history",
    "on-this-day",
    "ai-images",
    "educational"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "live-server": "^1.x.x",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.x.x",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "modern-normalize": "^3.0.1"
  }
}
